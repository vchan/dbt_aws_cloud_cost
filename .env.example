# Copy to .env (git-ignored) and fill in. See README.

# Bearer token for the Lake Compute API at base_url in profiles.yml.
LAKE_COMPUTE_AUTH_TOKEN=

# Optional: build into a different BigQuery dataset than `aws_cloud_cost`
# (macros/generate_schema_name.sql). Used for the comparison reference build.
# AWS_CLOUD_COST_TARGET_SCHEMA=aws_cloud_cost_reference

# Needed for the lakecompute adapter, which is experimental in dbt Fusion.
DBT_ENGINE_EXPERIMENTAL_MULTI_ADAPTER=true
